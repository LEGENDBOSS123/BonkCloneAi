# Python
python/.venv/
**/__pycache__/
*.pyc

# Node
node_modules/
config.py
# Training outputs — full checkpoints are 100+ MB each (they bundle the whole
# snapshot + exploiter pool). Don't commit them; ship a slim model in models/
# via `python -m bonk.export_model` instead.
runs/
metrics.jsonl

# Scratch / local
message.txt
*.log

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# bonk-recreation build outputs (the Rust engine is built locally via
# python/bonk3/build.sh; box2dweb-rs is a private submodule)
bonk-recreation/**/target/
bonk-recreation/**/node_modules/
# Decoded maps are regenerable from maps.json via tools/decode_maps.mjs;
# keep the two we actually use, ignore bulk --all dumps.
python/bonk3/maps/[0-9][0-9][0-9][0-9]-*.json


run_*.sh

test_*
models/*
blog/*
